---
import { withBase } from "../base";
// Replaces Starlight's fixed header + fixed full-height sidebar with the ansi layout:
// a sticky bar, a full-width banner, then one centred 1328px grid (side, doc, toc), then the footer.
import VersionBanner from "../components/VersionBanner.astro";
import { isBlogPage } from "../blog";
import { siteLinks } from "../site-links";
import { version } from "../version";
const { hasSidebar, id } = Astro.locals.starlightRoute;
const blog = isBlogPage(id); // the blog is unversioned: no version banner or picker
---

<header class="bar">
  <slot name="header" />
</header>
{!blog && <VersionBanner />}
<div class="docs-grid">
  {hasSidebar && (
    <nav class="side" aria-label={blog ? "the blog" : "the docs"}>
      <slot name="sidebar" />
    </nav>
  )}
  <slot />
</div>
<footer class="docs-foot">
  <p>
    ship is licensed under the{" "}
    <a href="https://github.com/shipmux/ship/blob/main/LICENSE">gnu general public license v3.0 or later</a>. it is a
    work in progress.
  </p>
  <nav aria-label="footer">
    <a href={withBase("/")}>back to the ship</a>
    {siteLinks(`${version.prefix}/`).map((l) => (
      <a href={l.href}>{l.label}</a>
    ))}
  </nav>
</footer>
<script>
  // the part of the ansi site.js the docs need: a crewmate loop pauses while it is off screen.
  // (site.js itself would also wire its copy buttons onto Expressive Code's own .copy wrappers.)
  const watch = new IntersectionObserver((entries) =>
    entries.forEach((en) => en.target.classList.toggle("off", !en.isIntersecting)),
  );
  document.querySelectorAll(".act").forEach((el) => watch.observe(el));
</script>
