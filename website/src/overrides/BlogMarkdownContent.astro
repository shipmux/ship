---
// MarkdownContent when the build has posts (astro.config.mjs picks it): posts go through starlight-blog's
// MarkdownContent for the date, tags and prev/next links, then our end block; everything else through ours. The plugin's wraps
// Starlight's default, so markdown.css comes back on post pages. Its import needs the plugin registered,
// which is why this is a separate override rather than a branch in MarkdownContent.astro.
import BlogContent from "starlight-blog/components/MarkdownContent.astro";
import BlogEnd from "../components/BlogEnd.astro";
import Doc from "./MarkdownContent.astro";
import { isBlogPost } from "../blog";
---

{isBlogPost(Astro.locals.starlightRoute.id) ? (
  <div class="doc">
    <BlogContent>
      <slot />
    </BlogContent>
    <BlogEnd />
  </div>
) : (
  <Doc>
    <slot />
  </Doc>
)}
