---
import Search from "./Search.astro"; // our override, which is what Starlight's virtual module resolves to
import SiteHeader from "../components/SiteHeader.astro";
import { version } from "../version";
import { isBlogPage } from "../blog";
---

<SiteHeader current={isBlogPage(Astro.locals.starlightRoute.id) ? "blog" : "docs"} docs={`${version.prefix}/`}>
  <Search />
</SiteHeader>
